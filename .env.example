# ResumeIQ — Environment Variables Configuration

# Flask Application Configuration
SECRET_KEY=resumeiq-super-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Defaults to SQLite database/resumeiq.db
DATABASE_URL=sqlite:///database/resumeiq.db

# Upload & File Validation Limits
MAX_FILE_SIZE_MB=5
RESUME_VALIDATION_THRESHOLD=0.70

# AI & Machine Learning Configuration
# Uses HuggingFace sentence-transformers/all-MiniLM-L6-v2 locally (No paid third-party API keys required)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
